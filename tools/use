#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# 归墟 use —— 项目的核心动词。
#
# 把一个过去的事件,作为"完整经验",喂给一个新任务。
# 这就是 7ny -> 7ny3 那次手动操作的自动化。没有这一步,归墟只是一个文件夹 + 一套哲学。
#
# 设计成薄壳:它不替你做智能(智能在模型那)。它只干三件事:
#   1. 取出某个事件的完整原始过程(默认用 defanged 副本,绝不把活 key 喂给外部模型)
#   2. 把"那段过程被压成可读对话 + 你的新任务"拼成一份上下文
#   3. 打到 stdout(管道给任意 agent),或 --run 直接起一个本机 claude 会话
#
# 用法:
#   ./tools/use <事件目录> "<新任务>"          组装上下文 -> stdout(管道给任何 agent/API)
#   ./tools/use <事件目录> "<新任务>" --run     若本机有 claude CLI,直接起一个带经验的会话

import sys
import os
import json
import shutil
import subprocess

TRUNCATE_TOOL_OUTPUT = 800   # 工具输出(文件内容/命令回显)很占 token,渲染时截断
SIZE_WARN_TOKENS = 700_000   # 经验值:超过这个量级,单次喂入接近百万窗口上限

def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

if len(sys.argv) < 3:
    die('用法: ./tools/use <事件目录> "<新任务>" [--run]')

event_dir = sys.argv[1]
task = sys.argv[2]
run = "--run" in sys.argv[3:]

if not os.path.isdir(event_dir):
    die(f"找不到事件目录: {event_dir}")

# 安全优先:有 defanged 副本就用它,绝不喂原件给外部模型。
candidates = [
    "transcript.defanged.jsonl",
    "transcript.jsonl",
    "raw.txt",
]
src = None
used_raw_original = False
for name in candidates:
    p = os.path.join(event_dir, name)
    if os.path.exists(p):
        src = p
        if name == "transcript.jsonl":
            used_raw_original = True
        break
if src is None:
    die(f"事件目录里没有可用的过程文件(找了 {candidates})")

if used_raw_original:
    print("警告: 只找到未脱敏原件 transcript.jsonl。--run 给外部模型前,先跑 ./tools/defang 生成 defanged 副本,"
          "否则可能把活密钥送出门。", file=sys.stderr)

def render_jsonl(path):
    """把 Claude Code 的 transcript JSONL 压成可读对话:保留发言与决策,截断臃肿的工具输出。"""
    lines_out = []
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for raw in f:
            raw = raw.strip()
            if not raw:
                continue
            try:
                rec = json.loads(raw)
            except json.JSONDecodeError:
                continue
            msg = rec.get("message") or {}
            role = msg.get("role") or rec.get("type") or ""
            content = msg.get("content")
            if content is None:
                continue
            if isinstance(content, str):
                lines_out.append(f"[{role}] {content}")
                continue
            for item in content:
                if not isinstance(item, dict):
                    continue
                t = item.get("type")
                if t == "text":
                    lines_out.append(f"[{role}] {item.get('text','')}")
                elif t == "tool_use":
                    inp = json.dumps(item.get("input", {}), ensure_ascii=False)
                    if len(inp) > TRUNCATE_TOOL_OUTPUT:
                        inp = inp[:TRUNCATE_TOOL_OUTPUT] + " …(截断)"
                    lines_out.append(f"[{role} 调用工具 {item.get('name','')}] {inp}")
                elif t == "tool_result":
                    c = item.get("content", "")
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                    c = str(c)
                    if len(c) > TRUNCATE_TOOL_OUTPUT:
                        c = c[:TRUNCATE_TOOL_OUTPUT] + " …(截断)"
                    lines_out.append(f"[工具结果] {c}")
    return "\n".join(lines_out)

if src.endswith(".jsonl"):
    body = render_jsonl(src)
else:
    with open(src, "r", encoding="utf-8", errors="replace") as f:
        body = f.read()

prompt = f"""下面是一次过去的完整工作过程的记录。它解决过一个和你接下来的任务相关的问题。

请先把它整个读一遍——不只看最终结果,更要看其中的决策、走过的弯路、踩的坑、为什么换方案。
那些过程里的经验,才是你要继承的东西。然后再动手做新任务。

==================== 过去的完整过程(开始) ====================
{body}
==================== 过去的完整过程(结束) ====================

你的新任务:
{task}
"""

# 体积诚实提示:这正是"喂整段"这条路的墙。撞墙了,说明你需要的是"选哪段"(未来的图书管理员),不是更大的窗口。
approx_tokens = len(prompt) // 4
if approx_tokens > SIZE_WARN_TOKENS:
    print(f"警告: 组装出的上下文约 {approx_tokens:,} tokens,接近/超过单次窗口上限。"
          f"这是 dump-whole 的墙——n 变大时你需要的是'选哪段倒进去',而不是硬塞。", file=sys.stderr)

if run:
    if not shutil.which("claude"):
        die("本机没有 claude CLI。去掉 --run 可把上下文打到 stdout,自己管道给任意 agent/API。")
    # 薄壳:把组装好的上下文交给 claude headless 跑。
    subprocess.run(["claude", "-p", prompt])
else:
    sys.stdout.write(prompt)
